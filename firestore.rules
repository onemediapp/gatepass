rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── Helpers ───────────────────────────────────────────
    function isAuth()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }
    function userDoc() { return get(/databases/$(db)/documents/users/$(uid())).data; }
    function hasRole(r){ return isAuth() && exists(/databases/$(db)/documents/users/$(uid())) && userDoc().role.hasAny([r]); }
    function isRep()    { return hasRole('rep'); }
    function isDoctor() { return hasRole('doctor'); }
    function isAdmin()  { return isAuth() && (request.auth.token.email.lower() == 'onemediapp@gmail.com' || hasRole('platform_admin') || hasRole('admin')); }
    function emailKey() { return request.auth.token.email.lower(); }

    // ── Invites (doctor onboarding). Platform Admin or Console ──
    match /invites/{email} {
      allow get: if isAuth() && (email == emailKey() || isAdmin());
      allow list, write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────
    // Self-create only as rep, or as doctor if invited. Role is immutable by the user.
    match /users/{userId} {
      allow get: if isAuth() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuth() && uid() == userId
        && (
          isAdmin()
          || (
            request.resource.data.role.size() == 1
            && (
              request.resource.data.role[0] == 'rep'
              || (request.resource.data.role[0] == 'doctor'
                  && exists(/databases/$(db)/documents/invites/$(emailKey())))
            )
          )
        );
      allow update: if isAuth() && (uid() == userId || isAdmin())
        && (
          isAdmin()
          || (request.resource.data.role == resource.data.role)
          || (
            !('role' in resource.data)
            && request.resource.data.role.size() == 1
            && (
              request.resource.data.role[0] == 'rep'
              || (request.resource.data.role[0] == 'doctor'
                  && exists(/databases/$(db)/documents/invites/$(emailKey())))
            )
          )
        );
      allow delete: if isAdmin();
    }

    // ── Rep profiles ──────────────────────────────────────
    // Owner always. A doctor may read only reps who have contacted them.
    match /reps/{repId} {
      allow read: if isAuth() && (
        uid() == repId
        || isAdmin()
        || (isDoctor() && exists(/databases/$(db)/documents/doctorRepLinks/$(uid() + '_' + repId)))
      );
      allow create, update: if isAuth() && uid() == repId && isRep();
    }

    // ── Doctor public profile (no phone, no private lists) ─
    match /doctors/{doctorId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && uid() == doctorId && isDoctor();
    }

    // ── Doctor private contact (WhatsApp/phone) ───────────
    // Owner, or a rep the doctor has approved (contactGrants).
    match /doctorContacts/{doctorId} {
      allow read: if isAuth() && (
        uid() == doctorId
        || exists(/databases/$(db)/documents/contactGrants/$(doctorId + '_' + uid()))
      );
      allow write: if isAuth() && uid() == doctorId && isDoctor();
    }
    match /contactGrants/{id} {
      allow read: if isAuth() && (id.matches(uid() + '_.*') || id.matches('.*_' + uid()));
      allow create, delete: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
      allow update: if false;
    }

    // ── Doctor's private rep relations (preferred/blocked/notes/counts) ──
    match /repRelations/{id} {
      allow read, write: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
    }

    // ── Rep contacted-doctor marker (lets a doctor read that rep) ──
    match /doctorRepLinks/{id} {
      allow create: if isAuth() && isRep()
        && id == (request.resource.data.doctorId + '_' + uid())
        && request.resource.data.repId == uid();
      allow read: if isAuth() && (id.matches(uid() + '_.*') || id.matches('.*_' + uid()));
      allow update, delete: if false;
    }

    // ── Clinics (public read for QR landing) ──────────────
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isAuth() && isDoctor() && request.resource.data.ownerDoctorId == uid();
      allow update, delete: if isAuth() && isDoctor() && resource.data.ownerDoctorId == uid();
    }
    match /doctorSlugs/{slug} {
      allow read: if true;
      allow create: if isAuth() && isDoctor() && request.resource.data.uid == uid();
      allow update, delete: if isAuth() && isDoctor() && resource.data.uid == uid();
    }
    match /doctorClinics/{id} {
      allow read: if isAuth();
      allow create, update: if isAuth() && isDoctor() && request.resource.data.doctorId == uid();
    }

    // ── Appointments: ONLY the rep and the target doctor ──
    match /appointments/{appointmentId} {
      allow create: if isAuth() && isRep()
        && request.resource.data.repId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.token == ''
        && request.resource.data.outcome == ''
        && request.resource.data.doctorNotes == ''
        && request.resource.data.slotStartAt > request.time;     // cannot book in the past
      allow get, list: if isAuth() && (
        uid() == resource.data.repId || uid() == resource.data.doctorId || isAdmin());
      allow update: if isAuth() && (
        uid() == resource.data.doctorId
        // Rep may ONLY: cancel, expire past pending, confirm attendance, mark arrival, dismiss a "moved" notice.
        || (uid() == resource.data.repId && (
             (request.resource.data.status == 'cancelled'
               && resource.data.status in ['pending','approved']
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                    ['status','cancelledBy','cancelReason','cancelledAt','lateCancel',
                     'lastChangeAt','lastChangeBy','rescheduledTo']))
             || (request.resource.data.status == 'expired'
               && resource.data.status == 'pending'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                    ['status','lastChangeAt','lastChangeBy']))
             || request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                    ['repConfirmedAt','arrivedAt','movedSeenByRep'])
           ))
      );
      allow delete: if false;
    }

    // ── Tokens: only the owning rep and doctor ────────────
    match /tokens/{tokenCode} {
      allow read: if isAuth() && (uid() == resource.data.repId || uid() == resource.data.doctorId);
      allow create: if isAuth() && isDoctor() && request.resource.data.doctorId == uid();
      allow update: if isAuth() && (
        (isDoctor() && request.resource.data.doctorId == uid())
        || (isRep() && resource.data.repId == uid() && request.resource.data.isUsed == true)
      );
      allow delete: if false;
    }

    // ── Ledgers (public read, no personal data) ───────────
    // Doctor writes own. Rep may only DECREMENT by 1 (cancellation).
    // Known beta limitation: move to a Cloud Function before open signup.
    match /slotLedger/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
      allow update: if isAuth() && (
        (isDoctor() && id.matches(uid() + '_.*'))
        || (isRep() && request.resource.data.approvedCount == resource.data.approvedCount - 1));
    }
    match /dayLedger/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
      allow update: if isAuth() && (
        (isDoctor() && id.matches(uid() + '_.*'))
        || (isRep() && request.resource.data.approvedCount == resource.data.approvedCount - 1));
    }
    match /weekLedger/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
      allow update: if isAuth() && (
        (isDoctor() && id.matches(uid() + '_.*'))
        || (isRep() && request.resource.data.approvedCount == resource.data.approvedCount - 1));
    }

    // ── Company-level doctor-private relations ─────────────────────
    match /companyRelations/{id} {
      allow read, write: if isAuth() && isDoctor() && id.matches(uid() + '_.*');
    }

    // ── Review requests ────────────────────────────────────────────
    match /reviewRequests/{id} {
      allow create: if isAuth() && isRep()
        && request.resource.data.repId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.message.size() <= 400
        && get(/databases/$(db)/documents/doctors/$(request.resource.data.doctorId)).data.comms.allowReviewRequests == true;
      allow read: if isAuth() && (uid() == resource.data.repId || uid() == resource.data.doctorId);
      allow update: if isAuth() && isDoctor() && uid() == resource.data.doctorId;
      allow delete: if false;
    }

    // ── Ask a doctor to join ───────────────────────────────────────
    match /doctorRequests/{id} {
      allow create: if isAuth() && isRep() && request.resource.data.repId == uid();
      allow read: if isAuth() && (resource.data.repId == uid() || isAdmin() || isDoctor());
      allow update, delete: if false;
    }

    // ── Notices: any signed-in user reads, doctor owns ────
    match /notices/{noticeId} {
      allow read: if isAuth();
      allow create: if isAuth() && isDoctor() && request.resource.data.doctorId == uid();
      allow update, delete: if isAuth() && isDoctor() && resource.data.doctorId == uid();
    }

    // ── Visit history: owner rep or doctor ────────────────
    match /visitHistory/{visitId} {
      allow read: if isAuth() && (uid() == resource.data.repId || uid() == resource.data.doctorId);
      allow create: if isAuth() && isDoctor() && request.resource.data.doctorId == uid();
      allow update, delete: if false;
    }

    // ── Multi-Tenant Branches ─────────────────────────────
    match /branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAuth() && (isDoctor() || isAdmin());
    }

    // ── Clinic Staff & RBAC ───────────────────────────────
    match /clinicStaff/{staffId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (isDoctor() || isAdmin());
    }

    // ── Location-Specific Schedules ───────────────────────
    match /doctorBranchSchedules/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (isDoctor() || isAdmin());
    }

    // ── Pharma Companies & Verification ───────────────────
    match /pharmaCompanies/{companyId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Territories & Field Teams ─────────────────────────
    match /territories/{territoryId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // ── Multi-Tenant Subscriptions & Billing ──────────────
    match /platformSubscriptions/{subId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isDoctor() || isAdmin());
    }
  }
}
